@prefix mco:  <https://akashtalole.github.io/CILMUMBAI/ontology/mco#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

mco:TenderShape a sh:NodeShape ;
    sh:targetClass mco:Tender ;
    sh:property [ sh:path mco:estimatedCost ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
    sh:property [ sh:path mco:emd ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
    sh:property [ sh:path mco:publishedOn ; sh:maxCount 1 ; sh:datatype xsd:date ;
                  sh:lessThanOrEquals mco:closesOn ; sh:message "a tender cannot close before it is published" ] ;
    sh:property [ sh:path mco:closesOn ; sh:maxCount 1 ; sh:datatype xsd:date ] .

mco:AllocationShape a sh:NodeShape ;
    sh:targetClass mco:Allocation ;
    sh:property [ sh:path mco:amountBe ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
    sh:property [ sh:path mco:amountRe ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
    sh:property [ sh:path mco:amountActual ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] .

mco:ContractShape a sh:NodeShape ;
    sh:targetClass mco:Contract ;
    sh:property [ sh:path mco:value ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
    sh:property [ sh:path mco:durationDays ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] .

mco:DefectLiabilityPeriodShape a sh:NodeShape ;
    sh:targetClass mco:DefectLiabilityPeriod ;
    sh:property [ sh:path mco:fromDate ; sh:maxCount 1 ; sh:datatype xsd:date ;
                  sh:lessThanOrEquals mco:toDate ; sh:message "a liability period cannot end before it starts" ] ;
    sh:property [ sh:path mco:toDate ; sh:maxCount 1 ; sh:datatype xsd:date ] .

mco:AdminWardShape a sh:NodeShape ;
    sh:targetClass mco:AdminWard ;
    sh:property [ sh:path mco:code ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:message "an administrative ward needs its code, e.g. K/W" ] .
