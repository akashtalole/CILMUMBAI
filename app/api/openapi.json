      "get": {
        "description": "The caller's alerts, newest first, each in its saved area's language with a link to the source page.",
        "operationId": "my_alerts_alerts_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response My Alerts Alerts Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "My Alerts"
      }
    },
