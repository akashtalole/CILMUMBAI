{
  "components": {
    "schemas": {
      "AnswerCheck": {
        "properties": {
          "cited_fact_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 200,
            "title": "Cited Fact Ids",
            "type": "array"
          },
          "language": {
            "anyOf": [
              {
                "pattern": "^(mr|hi|en)$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "text": {
            "maxLength": 20000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "AnswerCheck",
        "type": "object"
      },
      "GateDecision": {
        "properties": {
          "decision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ],
            "title": "Decision"
          },
          "reason": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "decision",
          "reason"
        ],
        "title": "GateDecision",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Question": {
        "properties": {
          "language": {
            "anyOf": [
              {
                "pattern": "^(mr|hi|en)$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "lat": {
            "anyOf": [
              {
                "maximum": 90.0,
                "minimum": -90.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lat"
          },
          "lon": {
            "anyOf": [
              {
                "maximum": 180.0,
                "minimum": -180.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lon"
          },
          "question": {
            "maxLength": 1000,
            "minLength": 3,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "Question",
        "type": "object"
      },
      "SavedArea": {
        "description": "A point with a radius, or named roads (SPEC-010/R1).",
        "properties": {
          "kind": {
            "pattern": "^(point|roads)$",
            "title": "Kind",
            "type": "string"
          },
          "language": {
            "pattern": "^(mr|hi|en)$",
            "title": "Language",
            "type": "string"
          },
          "lat": {
            "anyOf": [
              {
                "maximum": 90.0,
                "minimum": -90.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lat"
          },
          "lon": {
            "anyOf": [
              {
                "maximum": 180.0,
                "minimum": -180.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lon"
          },
          "radius_m": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Radius M"
          },
          "road_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Road Ids",
            "type": "array"
          }
        },
        "required": [
          "kind",
          "language"
        ],
        "title": "SavedArea",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Sourced facts about Mumbai's civic spending and works. Not an official record.",
